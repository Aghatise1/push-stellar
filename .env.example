# Copy this file to an ignored .env for local configuration, or use protected host settings.
PUSH_ENV=development
# Production requires a strong random secret, actual hostname, HTTPS and SMTP.
PUSH_SECRET_KEY=
PUSH_ALLOWED_HOSTS=localhost,127.0.0.1
PUSH_EMAIL_HOST=
PUSH_EMAIL_USER=
PUSH_EMAIL_PASSWORD=
PUSH_EMAIL_FROM=
PUSH_EMAIL_PORT=587
# Hard daily recipient ceiling. Delivery stops before the provider can run away with the budget.
PUSH_EMAIL_DAILY_LIMIT=250
# For Gmail, use smtp.gmail.com and a Google App Password, never your normal password.
# When all four email settings are present, real delivery is enabled in development too.
PUSH_ORIGIN=http://127.0.0.1:8765
# Supabase/managed PostgreSQL connection URL. Leave blank to use local SQLite in development.
# For this persistent Django service, use Supabase's Session pooler URL on port 5432.
# URL-encode reserved password characters.
PUSH_DATABASE_URL=
# Google OAuth web client. Keep the secret in the server environment.
# Local callback: http://127.0.0.1:8765/accounts/google/login/callback/
PUSH_GOOGLE_CLIENT_ID=
PUSH_GOOGLE_CLIENT_SECRET=
# Fixed public testnet values normally need no override. They are listed here
# to make the deployed network explicit; never replace them with secret keys.
STELLAR_TESTNET_HORIZON=https://horizon-testnet.stellar.org
STELLAR_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_TESTNET_SOROBAN_RPC=https://soroban-testnet.stellar.org
PUSH_MILESTONE_CONTRACT_ID=CBHGI6TOJMIUPHDQ6BY27YII3VLLYDDSAQ7U3PXUIG5QJ3GSXZRYUT2A
# Keep disabled until the contract receives an independent security review.
PUSH_SOROBAN_ESCROW_ENABLED=false
